VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional newer browser-safe key (use instead of the anon-key line above):
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side only. Never rename this to VITE_GEMINI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Server-side signing secret only; demo users never enter it and it is never sent to the browser.
# Use a random value with at least 32 characters; remove it after the demonstration to disable Demo Access.
# SENTINEL_DEMO_SIGNING_SECRET=
